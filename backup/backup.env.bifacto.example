# Config NOW-25 — hôte prod « bifacto ». Copier en backup.env.bifacto (gitignoré).
# Chargé par systemd via now-restore-check@bifacto.service (EnvironmentFile), et
# sourçable en bash pour un run manuel : set -a; . backup.env.bifacto; set +a
#
# Format compatible bash ET systemd EnvironmentFile (KEY=valeur, guillemets pour
# les valeurs à espaces). Pas d'expansion shell (pas de $VAR, pas de export).

# --- Source prod ---
PROD_SSH_HOST=bifacto
PROD_DB_CONTAINER=infra_mysql_8_0
# Bases PROD à contrôler (convention prod_*). Séparées par des espaces.
BACKUP_DATABASES="prod_bifacto_api prod_bifacto_doc"

# --- Contrôle de taille (seuils asymétriques) ---
SIZE_SHRINK_PCT=25
SIZE_GROWTH_PCT=100
HISTORY_WINDOW=8

# --- Alerting (API Brevo, HTTPS, forcé IPv4) ---
ALERT_EMAIL_TO=simon@nowis.fr
# Clé API Brevo (xkeysib-…) — même clé que nowis (compte Brevo mutualisé).
ALERT_BREVO_API_KEY=
# Expéditeur VÉRIFIÉ dans le compte Brevo utilisé.
ALERT_BREVO_SENDER=no-reply@nowis.fr
ALERT_WEBHOOK_URL=

# --- Divers ---
# Envoyer aussi un e-mail quand tout est OK (preuve que le run a bien eu lieu).
NOTIFY_SUCCESS=1
