# Config du contrôle hebdo de restauration (NOW-25) — RÉFÉRENCE COMPLÈTE des
# variables disponibles (SMTP de secours, HISTORY_FILE, WORK_ROOT, etc.).
#
# Déploiement multi-hôtes : une config PAR hôte prod, chargée par l'unité
# templatée now-restore-check@<hôte>.service. Partir des modèles prêts à
# l'emploi backup.env.nowis.example / backup.env.bifacto.example plutôt que de
# ce fichier :
#   cp backup.env.nowis.example   backup.env.nowis     && $EDITOR backup.env.nowis
#   cp backup.env.bifacto.example backup.env.bifacto   && $EDITOR backup.env.bifacto
# (backup.env.<hôte> est gitignoré.)

# --- Source prod ---
PROD_SSH_HOST=bifacto
PROD_DB_CONTAINER=infra_mysql_8_0
# Bases à sauvegarder/tester (séparées par des espaces)
BACKUP_DATABASES="appbifacto docbifacto"

# --- Contrôle de taille (seuils asymétriques) ---
# Un dump qui RÉTRÉCIT au-delà de ce % sous la médiane = ALERTE bloquante
# (dump tronqué ou perte de données).
SIZE_SHRINK_PCT=25
# Un dump qui GROSSIT au-delà de ce % au-dessus de la médiane = simple
# avertissement par e-mail, sans échec (la croissance métier est normale).
SIZE_GROWTH_PCT=100
# Nombre de JOURS d'historique retenus pour la médiane (fenêtre glissante).
# Plusieurs runs le même jour ne comptent que pour un point (le dernier).
HISTORY_WINDOW=8

# --- Alerting ---
# Destinataire (laisser vide pour désactiver l'e-mail)
ALERT_EMAIL_TO=simon@nowis.fr

# Canal e-mail PRÉFÉRÉ en prod : API Brevo (HTTPS, fiable, forcé en IPv4 car la
# clé Brevo est restreinte par IP allow-list). Réutilise la clé de l'app bifacto.
# ALERT_BREVO_API_KEY=xkeysib-...
# ALERT_BREVO_SENDER doit être un expéditeur VÉRIFIÉ dans Brevo.
ALERT_BREVO_SENDER=contact@domiciliationbulgarie.com

# Fallback SMTP brut (utilisé seulement si ALERT_BREVO_API_KEY est vide).
# En local : mailpit (localhost:1025). En prod sans MTA : laisser Brevo gérer.
ALERT_SMTP_HOST=localhost
ALERT_SMTP_PORT=1025
ALERT_SMTP_FROM=backup-check@nowis.fr

# Webhook (Slack/Discord/générique) — laisser vide pour désactiver
ALERT_WEBHOOK_URL=

# --- Divers ---
# HISTORY_FILE=/home/webadmin/Infra/backup/.restore-history.csv
# WORK_ROOT=/tmp
