# Config du contrôle hebdo de restauration (NOW-25).
# Copier en backup/backup.env (gitignoré) et adapter.

# --- Source prod ---
PROD_SSH_HOST=bifacto
PROD_DB_CONTAINER=infra_mysql_8_0
# Bases à sauvegarder/tester (séparées par des espaces)
BACKUP_DATABASES="appbifacto docbifacto"

# --- Contrôle de taille ---
# Alerte si la taille du dump s'écarte de +/- ce % de la médiane historique.
SIZE_DEVIATION_PCT=40

# --- Alerting ---
# E-mail (laisser ALERT_EMAIL_TO vide pour désactiver le mail)
ALERT_EMAIL_TO=simon@nowis.fr
ALERT_SMTP_HOST=localhost
ALERT_SMTP_PORT=1025          # 1025 = mailpit ; 25/587 = MTA réel
ALERT_SMTP_FROM=backup-check@nowis.fr

# Webhook (Slack/Discord/générique) — laisser vide pour désactiver
ALERT_WEBHOOK_URL=

# --- Divers ---
# HISTORY_FILE=/home/webadmin/Infra/backup/.restore-history.csv
# WORK_ROOT=/tmp
