[Unit]
Description=NOW — Déclencheur hebdomadaire du contrôle de restauration (NOW-25)

[Timer]
# Tous les lundis à 04h30 (heure serveur). Persistent=true → rattrape le run
# manqué si le serveur était éteint à l'heure prévue.
OnCalendar=Mon *-*-* 04:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
