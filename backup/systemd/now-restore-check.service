# Unité systemd (--user ou système) pour le contrôle hebdo de restauration.
# Installation (mode utilisateur, recommandé sur ce serveur sans cron) :
#   mkdir -p ~/.config/systemd/user
#   cp now-restore-check.{service,timer} ~/.config/systemd/user/
#   loginctl enable-linger webadmin            # pour tourner hors session
#   systemctl --user daemon-reload
#   systemctl --user enable --now now-restore-check.timer
#   systemctl --user list-timers                # vérifier le prochain run
#
# Ajuster ExecStart au chemin réel du dépôt Infra sur le serveur.
[Unit]
Description=NOW — Contrôle hebdomadaire de restauration des sauvegardes (NOW-25)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Infra/backup
ExecStart=%h/Infra/backup/weekly-restore-check.sh
# Timeout généreux (dump + restore + checks) ; ajuster si les bases grossissent.
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
