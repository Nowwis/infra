# Copié en .docker/.env (non versionné). Les valeurs locales sont celles par défaut ;
# en prod, seules les lignes marquées [prod] changent.

# symfony | wordpress | prestashop | php | html
PROJECT_TYPE=symfony
# Services démarrés selon le type : html → (vide) · wordpress, prestashop, php → php
# · symfony → php,assets. En prod, ajouter worker pour le consommateur Messenger.
COMPOSE_PROFILES=php,assets

# Nom court, unique sur l'hôte : préfixe des conteneurs, routeurs Traefik, base de données.
# Environnement de développement sur le serveur : un autre nom (site-dev), sinon ses conteneurs,
# routeurs et image remplacent ceux de la prod.
COMPOSE_PROJECT_NAME=site
COMPOSE_PROJECT_DOMAIN=site.docker.test
# [prod] Domaine servi sur le serveur (docker-compose.prod.yml) : example.com en prod,
# dev.example.com pour l'environnement de développement.
COMPOSE_PRODUCTION_DOMAIN=site.example
# [prod] 1 pour un domaine racine (example.com) : www.example.com redirige vers example.com.
# Laisser 0 pour un sous-domaine (doc.example.com, dev.example.com) : www.<sous-domaine> n'a pas
# de DNS et ferait échouer le certificat.
PROD_WWW_ALIAS=0
# [prod] Règle Traefik des alias redirigés vers COMPOSE_PRODUCTION_DOMAIN, à la place de www seul.
# Vide = www.<domaine> si PROD_WWW_ALIAS=1, aucun alias sinon. Chaque hôte doit avoir son DNS.
# Exemple : Host(`www.example.com`) || Host(`example.org`) || Host(`www.example.org`)
TRAEFIK_ALIAS_RULE=
# [prod] Basic auth devant le site (environnement de développement). Vide = aucune. Valeur :
# `htpasswd -nbB <compte> <mot de passe>`, plusieurs comptes séparés par des virgules, et chaque $
# doublé ($$) : compte:$$2y$$05$$… (un $ simple est lu comme une variable et casse le hash).
TRAEFIK_AUTH_USERS=

TRAEFIK_ENTRYPOINT=websecure
# Vide en local (certificat mkcert du socle) ; la prod utilise « le » dans son propre fichier.
TRAEFIK_CERTRESOLVER=

# Version PHP : dans .docker/php/Dockerfile (FROM), versionnée avec le code, jamais ici. De même pour
# les compléments d'image (wkhtmltopdf, pcov, paquets et extensions PECL) : build.args du service php
# dans .docker/docker-compose[.prod].project.yml.
COMPOSER_VERSION=2
ENABLE_XDEBUG=0
APP_FOLDER=../
UID=1000
GID=1000

# PrestaShop : nom du dossier d'administration.
ADMIN_FOLDER_PRESTASHOP=admin_dev

# WordPress (PROJECT_TYPE=wordpress) : base locale sur le socle, créée par `make db-create`,
# lue par wp-config.php (copie de .docker/wp-config.local.php, `make wp-config`).
WORDPRESS_DB_HOST=infra_mysql_8_0
WORDPRESS_DB_NAME=site
WORDPRESS_DB_USER=site
WORDPRESS_DB_PASSWORD=site-local
# Préfixe des tables de la base importée ; vide = wp_.
WORDPRESS_TABLE_PREFIX=
# 1 : pas de WP-Cron au chargement des pages.
WORDPRESS_DISABLE_CRON=0
# Copies depuis le serveur (make db-pull, files-pull), vides par défaut : voir .docker/make/wordpress.mk.
REMOTE=
REMOTE_PROD=
PROD_URL=
LOCAL_URL=
WP_VERSION=
WP_LOCALE=
WP_LOCAL_DEACTIVATE=
