# Copier en .env (gitignoré) et renseigner. `make check` refuse de déployer tant qu'une
# variable obligatoire est vide ou qu'un hash contient un `$` non doublé.
#
# Deux profils : local (poste ou labo : mkcert, pas de Let's Encrypt, écoute restreinte)
# et prod (serveur : Let's Encrypt, écoute publique, journal d'accès).

# ---- Environnement -------------------------------------------------------------
# local | prod. Sélectionne traefik.<ENV>.yaml et configuration/traefik2/config/dynamic/<ENV>/.
ENV=local

# ---- Traefik -------------------------------------------------------------------
# Tableau de bord sans mot de passe : local uniquement. En prod : false.
TRAEFIK_DASHBOARD_INSECURE=true
# Middleware du tableau de bord : `auth` (basic-auth ci-dessous) ; vide = aucun (local).
TRAEFIK_MONITORING_MIDDLEWARE=auth
TRAEFIK_DASHBOARD_USERS=admin:{SHA}0DPiKuNIrrVmD8IUCuw1hQxNqZc=
# Entrypoint des routeurs du socle : websecure (443). `web` (80) n'est qu'une redirection.
TRAEFIK_ENTRYPOINT=websecure
# Résolveur de certificats : `le` en prod (Let's Encrypt), VIDE en local (certificat mkcert
# servi par le provider fichier, voir dynamic/local/main.yaml).
TRAEFIK_CERTRESOLVER=
# Adresse d'écoute, AVEC le deux-points final : "127.0.0.1:" (tunnel ssh), "<ip-privée>:" (VPN),
# vide = toutes les interfaces (serveur public).
TRAEFIK_BIND=127.0.0.1:
# Compte Let's Encrypt (prod uniquement, ignoré en local).
LETSENCRYPT_EMAIL=you@example.com

# ---- MySQL / MariaDB -----------------------------------------------------------
# Un seul mot de passe root, partagé par les deux moteurs.
MYSQL_ROOT_PASSWORD=changeme

# ---- Mailpit -------------------------------------------------------------------
# `mailpit-auth` pour protéger l'interface ; vide = libre (local derrière un VPN seulement).
TRAEFIK_MAILPIT_MIDDLEWARE=mailpit-auth
TRAEFIK_MAILPIT_USERS=admin:{SHA}0DPiKuNIrrVmD8IUCuw1hQxNqZc=

# ---- phpMyAdmin ----------------------------------------------------------------
# OBLIGATOIRE et PROPRE à phpMyAdmin (il ouvre toutes les bases de l'hôte). Vide = 404.
#
# Hash bcrypt recommandé, sans rien installer, les `$` déjà doublés pour Compose :
#   docker run --rm httpd:alpine htpasswd -nbB admin 'motdepasse' | tr -d '\n' | sed 's/\$/$$/g'
#
# ATTENTION : Compose interprète les `$` d'un .env. Un hash collé tel quel est TRONQUÉ en
# silence (`admin:$2y$05$abc…` devient `admin:$2y$05`) et plus aucun mot de passe ne marche.
# `make check` détecte un `$` seul ; vérifier aussi : docker compose config | grep phpmyadmin-auth
#
# Alternative sans échappement : hash {SHA} (`htpasswd -ns`), moins solide (SHA-1 non salé).
TRAEFIK_PHPMYADMIN_USERS=
PMA_UPLOAD_LIMIT=512M

# ---- Domaines ------------------------------------------------------------------
# Local : *.docker.test (couvert par le certificat mkcert). Prod : vrais sous-domaines.
MONITORING_DOMAIN=monitoring.docker.test
PMA_DOMAIN=phpmyadmin.docker.test
MAILPIT_DOMAIN=mailer.docker.test

# ---- Profils Compose permanents de l'hôte ---------------------------------------
# Lu par docker compose (et par make check) : évite de répéter PROFILES= à chaque commande.
# Exemples : vide (socle seul), `mariadb`, `gatus`, `mariadb,gatus`.
COMPOSE_PROFILES=

# ---- Gatus (profil `gatus`, surveillance externe + alertes Telegram) ------------
# Obligatoires dès que le profil est actif (make check). Sans profil : ignorées.
# Dossier de config Gatus de CET hôte : chemin ABSOLU, HORS de ce checkout, fourni par l'hôte
# (la liste de ce qu'il surveille n'est pas versionnée ici). Au moins un .yaml dedans.
# Forme d'un fichier : configuration/gatus/example/config.yaml.
GATUS_CONFIG_DIR=
# Page d'état. Local : status.docker.test. Prod : un sous-domaine dont le DNS pointe sur l'hôte
# (Let's Encrypt en défi HTTP). Différent de MONITORING_DOMAIN (tableau de bord Traefik).
GATUS_DOMAIN=status.docker.test
# OBLIGATOIRE et PROPRE à la page d'état (elle liste tous les domaines surveillés). Vide = 404.
# Même format que TRAEFIK_PHPMYADMIN_USERS (bcrypt, `$` doublés).
TRAEFIK_GATUS_USERS=
# Bot et destinataire Telegram. VIDES = Gatus démarre mais n'alerte jamais, sans erreur : d'où
# le contrôle de make check.
GATUS_TELEGRAM_TOKEN=
GATUS_TELEGRAM_CHAT_ID=
