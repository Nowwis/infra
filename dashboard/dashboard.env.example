# Copier en dashboard/dashboard.env (gitignored), puis ajuster.
# Consommé par `make dash-deploy` et bin/wt-dash-install pour (re)générer
# le secret basic-auth Traefik (certs/wt-dashboard.htpasswd) et l'unit systemd.

WT_DASH_USER=admin
# Mot de passe en clair : hashé (apr1) à l'install, jamais stocké en clair côté repo.
WT_DASH_PASSWORD=change-me

# --- overrides optionnels ---
# WT_DASH_PORT=8899
# WT_DASH_BIND=100.75.44.109        # IP d'écoute du service (IP Tailscale de l'hôte)
# WT_DASH_HOSTADDR=100.75.44.109    # adresse par laquelle Traefik joint le service
# Alternative au mot de passe : ligne htpasswd déjà hashée
# WT_DASH_HTPASSWD=admin:$apr1$....
