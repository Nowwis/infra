#!/usr/bin/env bash
# Installer/uninstaller for the wt dashboard.
#
# Writes a systemd --user unit (php -S … dashboard/server/router.php) and
# generates the Traefik basic-auth secret file (an htpasswd line).
#
# The Traefik ROUTE itself is committed in
#   configuration/traefik2/config/dynamic_conf.local.yaml
# and references the secret via basicAuth.usersFile, so this installer never
# mutates that shared file (no inode/bind-mount churn, clean working tree).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; ROOT="$(dirname "$HERE")"
PORT="${WT_DASH_PORT:-8899}"; BIND="${WT_DASH_BIND:-${WT_DASH_HOSTADDR:-100.75.44.109}}"
UNIT_DIR="${WT_DASH_UNIT_DIR:-$HOME/.config/systemd/user}"; UNIT="$UNIT_DIR/wt-dashboard.service"
# htpasswd lives in the certs dir (already gitignored AND bind-mounted into Traefik at /etc/certs)
HTPASSWD="${WT_DASH_HTPASSWD_FILE:-$ROOT/configuration/traefik2/certs/wt-dashboard.htpasswd}"
USER_NAME="${WT_DASH_USER:-admin}"

if [ "${1:-}" = "--uninstall" ]; then
  rm -f "$UNIT" "$HTPASSWD"
  if [ "${WT_DASH_RELOAD:-}" != "true" ]; then
    command -v systemctl >/dev/null 2>&1 && { systemctl --user disable --now wt-dashboard.service 2>/dev/null || true; systemctl --user daemon-reload 2>/dev/null || true; }
  fi
  echo "wt-dashboard uninstalled (unit + secret removed; the committed Traefik route stays in git)"
  exit 0
fi

# --- systemd --user unit ---
mkdir -p "$UNIT_DIR"
cat > "$UNIT" <<EOF
[Unit]
Description=wt dashboard

[Service]
ExecStart=/usr/bin/php -S ${BIND}:${PORT} -t ${ROOT}/dashboard/public ${ROOT}/dashboard/server/router.php
Restart=on-failure

[Install]
WantedBy=default.target
EOF

# --- basic-auth secret (htpasswd line consumed by Traefik usersFile) ---
# Priority: explicit WT_DASH_HTPASSWD (pre-hashed) > WT_DASH_PASSWORD (plaintext, first run only)
# An existing secret is kept as-is on re-install (idempotent); rotate by passing
# WT_DASH_HTPASSWD or deleting the file first.
mkdir -p "$(dirname "$HTPASSWD")"
if [ -n "${WT_DASH_HTPASSWD:-}" ]; then
  printf '%s\n' "$WT_DASH_HTPASSWD" > "$HTPASSWD"
elif [ ! -s "$HTPASSWD" ]; then
  if [ -n "${WT_DASH_PASSWORD:-}" ]; then
    printf '%s:%s\n' "$USER_NAME" "$(openssl passwd -apr1 "$WT_DASH_PASSWORD")" > "$HTPASSWD"
  else
    echo "wt-dash-install: no secret. Set WT_DASH_PASSWORD (or WT_DASH_HTPASSWD) — see dashboard/dashboard.env.example" >&2
    exit 1
  fi
fi
chmod 600 "$HTPASSWD"

if [ "${WT_DASH_RELOAD:-}" != "true" ]; then
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user enable --now wt-dashboard.service 2>/dev/null || true
  fi
fi
echo "wt-dashboard installed (port ${PORT}; secret ${HTPASSWD}; route committed in dynamic_conf.local.yaml)"
