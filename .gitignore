.idea/

/datas/*
!/datas/.gitkeep

/configuration/traefik2/certs/*
!/configuration/traefik2/certs/.gitkeep
/configuration/traefik2/logs/*
!/configuration/traefik2/logs/.gitkeep

/letsencrypt/*
!/letsencrypt/.gitkeep

.env
# secret de la console (le htpasswd est déjà couvert par /configuration/traefik2/certs/*)
/console/console.env
# backups locaux (env/compose)
*.bak
