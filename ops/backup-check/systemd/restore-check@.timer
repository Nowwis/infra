[Unit]
Description=Déclencheur hebdomadaire du contrôle de restauration %i

[Timer]
Unit=restore-check@%i.service
# Tous les lundis à 04h30 (heure serveur). Persistent=true → rattrape le run
# manqué si le serveur était éteint à l'heure prévue. RandomizedDelaySec évite
# que plusieurs instances (un par hôte contrôlé) démarrent exactement en même temps.
OnCalendar=Mon *-*-* 04:30:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
