# Unité systemd TEMPLATÉE (--user) pour le contrôle hebdo de restauration.
# L'instance (%i) désigne l'hôte à contrôler : restore-check@<hote>,
# restore-check@<hote2>, … Chaque instance charge sa propre config
# backup.env.<hote> (PROD_SSH_HOST, bases, alerting).
#
# Installation (mode utilisateur, recommandé, fonctionne sans cron) :
#   mkdir -p ~/.config/systemd/user
#   cp restore-check@.{service,timer} ~/.config/systemd/user/
#   loginctl enable-linger $USER            # pour tourner hors session
#   systemctl --user daemon-reload
#   systemctl --user enable --now restore-check@<hote>.timer
#   systemctl --user enable --now restore-check@<hote2>.timer
#   systemctl --user list-timers               # vérifier les prochains runs
#
# %h = home de l utilisateur ; adapter si le dépôt
# n est pas cloné en ~/infra.
[Unit]
Description=Contrôle hebdomadaire de restauration des sauvegardes %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/infra/ops/backup-check
# Chaque hôte a son fichier de config dédié (gitignoré).
EnvironmentFile=%h/infra/ops/backup-check/backup.env.%i
ExecStart=%h/infra/ops/backup-check/weekly-restore-check.sh
# Timeout généreux (dump + restore + checks) ; ajuster si les bases grossissent.
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
