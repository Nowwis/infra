# Contrôle hebdomadaire de restauration — une configuration PAR hôte contrôlé.
# Copier en backup.env.<hote> (gitignoré) ; l'unité restore-check@<hote>.service la charge.
# Format KEY=valeur lisible par bash et par systemd EnvironmentFile ; pas d'expansion.
#
# Ne JAMAIS créer backup.env sans suffixe : il serait sourcé par le script et écraserait la
# configuration passée par systemd.

# --- Serveur contrôlé (le script s'y connecte en ssh, lecture seule) ---
# Alias de ~/.ssh/config de la machine qui exécute le contrôle.
PROD_SSH_HOST=
# Conteneur MySQL sur ce serveur.
PROD_DB_CONTAINER=infra_mysql_8_0
# Bases à dumper puis restaurer, séparées par des espaces.
BACKUP_DATABASES=

# --- Contrôle de taille (seuils asymétriques) ---
# Un dump qui RÉTRÉCIT au-delà de ce % sous la médiane = ALERTE bloquante (troncature, perte).
SIZE_SHRINK_PCT=25
# Un dump qui GROSSIT au-delà de ce % = simple avertissement (la croissance est normale).
SIZE_GROWTH_PCT=100
# Jours d'historique pour la médiane, un point par jour (le dernier).
HISTORY_WINDOW=8

# --- Alerting : au moins un canal ---
# E-mail : destinataire (vide = pas d'e-mail).
ALERT_EMAIL_TO=
# Canal e-mail 1 : API Brevo (HTTPS, IPv4 forcé). Expéditeur VÉRIFIÉ dans le compte Brevo.
ALERT_BREVO_API_KEY=
ALERT_BREVO_SENDER=
# Canal e-mail 2 (repli si pas de clé Brevo) : SMTP brut. En local : Mailpit (localhost:1025).
ALERT_SMTP_HOST=localhost
ALERT_SMTP_PORT=1025
ALERT_SMTP_FROM=restore-check@localhost
# Webhook JSON {"text": "..."} (Slack, Discord, générique). Vide = désactivé.
ALERT_WEBHOOK_URL=
# Commande locale recevant le message sur stdin (ex. un envoi Telegram). Vide = désactivé.
ALERT_NOTIFY_CMD=
# 1 = notifier aussi les succès (utile au début, bruyant ensuite).
NOTIFY_SUCCESS=0

# --- Divers ---
# HISTORY_FILE=~/infra/ops/backup-check/.restore-history.csv
# WORK_ROOT=/tmp
