# Copier en console/console.env (gitignored), puis ajuster.
# Consommé par `make console-deploy` et bin/console-install pour (re)générer
# le secret basic-auth Traefik (certs/console.htpasswd) et les unités systemd.

CONSOLE_USER=admin
# Mot de passe en clair : hashé (apr1) à l'install, jamais stocké en clair côté repo.
CONSOLE_PASSWORD=change-me

# --- surcharges optionnelles ---
# CONSOLE_PORT=8899
# CONSOLE_BIND=100.75.44.109        # IP d'écoute du service (IP Tailscale de l'hôte)
# CONSOLE_HOSTADDR=100.75.44.109    # adresse par laquelle Traefik joint le service
# Alternative au mot de passe : ligne htpasswd déjà hashée
# CONSOLE_HTPASSWD=admin:$apr1$....
